# =====================================
# SERVER
# =====================================

NODE_ENV=development
PORT=3001

# =====================================
# DATABASE - SUPABASE POSTGRESQL
# =====================================

DB_HOST=seu-host-do-supabase
DB_PORT=5432
DB_NAME=postgres
DB_USER=seu-usuario
DB_PASSWORD=sua-senha-do-banco
DB_SSL=true

# =====================================
# AUTHENTICATION - JWT
# =====================================

JWT_SECRET=crie-uma-chave
JWT_EXPIRES_IN=1h